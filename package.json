{
  "name": "atl_codex",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop and CLI tools for the ANTC .atl binary format by Air Conditioner (AC9892)",
  "author": "Air Conditioner (AC9892)",
  "license": "LicenseRef-Air-Conditioner-Anti-Selling",
  "main": "./desktop/main.js",
  "bin": {
    "atl_codex": "./src/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node ./test/antc.test.js",
    "build:win": "electron-builder --win nsis",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ac989.antc.studio",
    "productName": "ANTC Studio",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "Icon",
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "Icon/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "Icon/Antc.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ANTC Studio",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
